# AI-Powered QA Review Pipeline - Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================
# FRONTEND VARIABLES (React App)
# ==============================================

# URL del API del agente local (solo necesario para el frontend)
VITE_API_URL=http://localhost:3001

# ==============================================
# BACKEND VARIABLES (Local Agent - Node.js)
# ==============================================

# OpenAI API Configuration (REQUERIDO)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Security - Clave de cifrado (REQUERIDO - mínimo 32 caracteres)
ENCRYPTION_KEY=your-secure-encryption-key-change-this-in-production-min-32-chars

# AI Model Configuration (OPCIONAL)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
AI_MODEL=gpt-4o-mini

# ==============================================
# DOCKER COMPOSE VARIABLES
# ==============================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qa_pipeline

# pgAdmin Configuration (opcional - solo si usas el perfil pgadmin)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ==============================================
# NOTAS PARA PRODUCCIÓN
# ==============================================

# Para despliegue en producción:
# 1. Genera una ENCRYPTION_KEY segura (mínimo 32 caracteres)
# 2. Usa una POSTGRES_PASSWORD fuerte
# 3. Cambia PGADMIN_EMAIL y PGADMIN_PASSWORD
# 4. Considera usar Docker secrets para valores sensibles
# 5. Configura certificados SSL para HTTPS

# Ejemplo de generación de clave de cifrado segura:
# - Node.js: require('crypto').randomBytes(32).toString('hex')
# - OpenSSL: openssl rand -hex 32
# - PowerShell: [System.Web.Security.Membership]::GeneratePassword(64, 0)
